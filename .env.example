MONGODB_URI=mongodb://localhost:27017/test_livechat_local
SESSION_SECRET=change_this_to_at_least_32_random_characters
PORT=5001
NODE_ENV=development

# Production origin controls
# Use comma-separated origins when multiple frontends are allowed.
CORS_ORIGINS=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:5001
VITE_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional production controls
API_RATE_LIMIT=600
AUTH_RATE_LIMIT=30
JSON_BODY_LIMIT=1mb
TRUST_PROXY=false

# Firebase configuration (required ONLY if you want Live Chat to work)
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=

# AI Configuration (required for Scoping, Ticketing, and Room Assistant)
# AI_PROVIDER can be auto, azure-openai, or gemini.
# auto uses Azure OpenAI when fully configured, otherwise Gemini when GEMINI_API_KEY is set.
AI_PROVIDER=auto

# Azure OpenAI chat provider
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=your_chat_model_deployment_name

# Gemini chat provider
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional Azure OpenAI deployments for media features
AZURE_OPENAI_IMAGE_DEPLOYMENT=
AZURE_OPENAI_AUDIO_DEPLOYMENT=
AZURE_OPENAI_TRANSCRIPTION_DEPLOYMENT=
