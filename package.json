{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/run-workspace.mjs api",
    "dev:client": "node scripts/run-workspace.mjs client",
    "seed": "node scripts/run-workspace.mjs seed",
    "build": "npm run typecheck && npm run build --workspaces --if-present",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm run typecheck --workspaces --if-present"
  },
  "private": true,
  "workspaces": [
    "artifacts/api-server",
    "artifacts/dehix-live-room",
    "lib/*",
    "lib/integrations/*",
    "scripts"
  ],
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
