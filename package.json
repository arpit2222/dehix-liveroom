{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/run-workspace.mjs api",
    "dev:client": "node scripts/run-workspace.mjs client",
    "seed": "node scripts/run-workspace.mjs seed",
    "render:build": "npx puppeteer browsers install chrome && npm run build",
    "build": "npm run typecheck && npm run build --workspaces --if-present",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm run typecheck --workspaces --if-present"
  },
  "private": true,
  "workspaces": [
    "artifacts/api-server",
    "artifacts/dehix-live-room",
    "lib/*",
    "lib/integrations/*",
    "scripts"
  ],
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.0": true,
    "@firebase/util@1.15.1": true,
    "protobufjs@7.6.1": true
  },
  "dependencies": {
    "jszip": "^3.10.1"
  }
}
